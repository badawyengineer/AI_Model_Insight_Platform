# .env.example
#
# Copy this to .env (which is gitignored - never commit real secrets)
# and fill in real values. Docker Compose reads .env automatically for
# ${VAR} substitution in docker-compose.yml.

# --- PostgreSQL ---
DB_NAME=ai_model_insight
DB_USER=postgres
DB_PASSWORD=changeme-pick-a-real-password
DB_PORT=5432

# --- Airflow webserver ---
# Generate a real one with: python -c "import secrets; print(secrets.token_hex(30))"
AIRFLOW_SECRET_KEY=changeme-generate-with-python-secrets-token-hex-30
