# Python
__pycache__/
*.py[cod]
*.egg-info/
venv/
.env

# Data (generated, not source-controlled)
raw_data/*
!raw_data/.gitkeep
clean_data/*
!clean_data/.gitkeep
logs/*
!logs/.gitkeep

# OS
.DS_Store

# IDE
.vscode/
.idea/

# Milestone 7: MLflow tracking store + ML artifacts (generated, not
# source-controlled - same reasoning as raw_data/clean_data above)
mlflow.db
mlruns/
mlartifacts/
models/*
!models/.gitkeep
raw_data/torch_datasets/
raw_data/mlflow_runs_raw.json

# Milestone 8: Airflow's own metadata DB / logs if AIRFLOW_HOME is
# ever pointed inside the repo (it shouldn't be, but just in case)
airflow_home/
airflow.db
airflow-webserver.pid

# Milestone 9: Docker Compose local secrets file - never commit real
# credentials, .env.example is the checked-in template
.env

# Milestone 10: Terraform state and variable files - state can contain
# resource attributes in plaintext, tfvars can contain values like
# allowed_cidr_blocks that shouldn't be assumed public
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/terraform.tfvars
terraform/*.auto.tfvars
terraform/crash.log
# NOTE: .terraform.lock.hcl is intentionally NOT ignored - like a
# package-lock.json, it should be committed so everyone applying this
# gets the same provider versions.

# Milestone 11: local Redis persistence file, if redis-server is ever
# run with its working directory inside the repo
dump.rdb

