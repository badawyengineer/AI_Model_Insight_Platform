# terraform/terraform.tfvars.example
#
# Copy to terraform.tfvars (gitignored) and fill in real values before
# running `terraform apply`.

aws_region   = "us-east-1"
project_name = "ai-model-insight"
environment  = "dev"

# IMPORTANT: leave this empty ([]) until you actually need to reach RDS
# from outside AWS (e.g. your laptop, for local testing against cloud
# data). Add only the specific CIDR you need, e.g. ["203.0.113.4/32"]
# for a single IP - never ["0.0.0.0/0"] outside of throwaway testing.
allowed_cidr_blocks = []

db_instance_class        = "db.t4g.micro"
db_allocated_storage_gb  = 20

tags = {
  Owner = "badawyengineer"
}
